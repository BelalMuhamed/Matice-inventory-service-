{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "MachineCommunication": {
    "TimeoutSeconds": 10
  },
  "InventoryApi": {
    "BaseUrl": "https://localhost:44360/"
  },
  "PrintAgentAuth": {
    "Issuer": "InventoryPlatform",
    "Audience": "InventoryPlatformPrintAgent",
    "SigningKey": ""
  }
}
